/* =========================================================
   GLOBAL
========================================================= */

QMainWindow {
    background-color: #131417;
}

QWidget {
    background-color: #131417;
    color: #e8e8e8;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
}


/* =========================================================
   MAIN TABS
========================================================= */

QTabWidget#mainTabs::pane,
QTabWidget#captureTabs::pane {
    background-color: #131417;
    border: 1px solid #2b3038;
    border-radius: 6px;
    top: -1px;
    padding: 8px;
}

QTabWidget#mainTabs > QTabBar::tab,
QTabWidget#captureTabs > QTabBar::tab {
    background-color: #1a1d23;
    color: #9aa3b2;
    border: 1px solid #2b3038;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 8px 14px;
    margin-right: 4px;
    min-width: 80px;
}

QTabWidget#mainTabs > QTabBar::tab:selected,
QTabWidget#captureTabs > QTabBar::tab:selected {
    background-color: #232830;
    color: #f0f0f0;
    border-color: #3d7ec8;
}

QTabWidget#mainTabs > QTabBar::tab:hover:!selected,
QTabWidget#captureTabs > QTabBar::tab:hover:!selected {
    background-color: #22262e;
    color: #d0d0d0;
}


/* =========================================================
   BUTTONS
========================================================= */

QPushButton {
    background-color: #232830;
    border: 1px solid #3a404d;
    border-radius: 6px;
    padding: 7px 14px;
    color: #f0f0f0;
    font-size: 13px;
    font-weight: 500;
    min-height: 28px;
}

QPushButton:hover {
    background-color: #2c323c;
    border-color: #4a5160;
}

QPushButton:pressed {
    background-color: #1a1e24;
}

QPushButton:disabled {
    background-color: #1a1c21;
    color: #5c6370;
    border-color: #2a2e36;
}

QPushButton#estopButton {
    background-color: #8b2222;
    border: 1px solid #b33a3a;
    font-size: 15px;
    font-weight: 700;
    min-height: 36px;
}

QPushButton#estopButton:hover {
    background-color: #a02828;
}

QPushButton#estopButton:disabled {
    background-color: #3d1515;
    color: #8a6060;
    border-color: #5a2222;
}

QPushButton#releaseButton {
    background-color: #1e5c40;
    border: 1px solid #2d8a5c;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#releaseButton:hover {
    background-color: #267050;
}

QPushButton#releaseButton:disabled {
    background-color: #152e21;
    color: #507060;
    border-color: #1d4d36;
}

QPushButton#leaseButton {
    background-color: #254a73;
    border: 1px solid #3a6a9f;
}

QPushButton#leaseButton:hover {
    background-color: #2d5685;
}

QPushButton#clearErrorBtn {
    background-color: transparent;
    border: 1px solid #4a5160;
    border-radius: 4px;
    padding: 2px;
    font-size: 12px;
    min-height: 22px;
    max-height: 22px;
    min-width: 22px;
    max-width: 22px;
}

QPushButton#clearErrorBtn:hover {
    background-color: #2c323c;
}


/* =========================================================
   PANELS & SEPARATORS
========================================================= */

QFrame#controlPanel {
    background-color: #181b20;
    border: 1px solid #2b3038;
    border-radius: 8px;
}

QWidget#sidebar {
    background-color: #181b20;
    border-right: 1px solid #2b3038;
}

QFrame#separator {
    background-color: #2b3038;
    border: none;
    max-height: 1px;
    min-height: 1px;
}


/* =========================================================
   GROUP BOXES
========================================================= */

QGroupBox {
    background-color: #181b20;
    border: 1px solid #2b3038;
    border-radius: 8px;
    margin-top: 14px;
    padding: 12px;
    padding-top: 22px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #d0d4dc;
}

QGroupBox:disabled {
    color: #5c6370;
    background-color: #15171c;
}


/* =========================================================
   LABELS
========================================================= */

QLabel {
    color: #e0e4ea;
    font-size: 13px;
    background: transparent;
}

QLabel#sectionHeader {
    font-size: 14px;
    font-weight: 600;
    color: #ffffff;
    padding-top: 2px;
    padding-bottom: 4px;
}

QLabel#mutedLabel {
    color: #8b939e;
    font-size: 12px;
}

QLabel#placeholderLabel {
    color: #6e7681;
    font-size: 13px;
}

QLabel#statusLabel {
    color: #9aa3b2;
    font-size: 12px;
}

QLabel#errorLabel {
    color: #e67e22;
    font-size: 12px;
    font-weight: 500;
}


/* =========================================================
   INPUTS
========================================================= */

QLineEdit,
QDoubleSpinBox {
    background-color: #111318;
    border: 1px solid #303540;
    border-radius: 6px;
    padding: 6px 10px;
    color: #e8e8e8;
    font-size: 13px;
    min-height: 24px;
}

QLineEdit:focus,
QDoubleSpinBox:focus {
    border: 1px solid #4a8fd4;
}

QLineEdit:disabled,
QDoubleSpinBox:disabled {
    color: #5c6370;
    background-color: #15171c;
}


/* =========================================================
   CHECKBOXES
========================================================= */

QCheckBox {
    spacing: 8px;
    font-size: 13px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #4a5160;
    background: #1e2229;
}

QCheckBox::indicator:checked {
    background-color: #3c7edb;
    border: 1px solid #6aa6ff;
}


/* =========================================================
   TEXT AREAS
========================================================= */

QTextEdit {
    background-color: #181b20;
    border: 1px solid #2d3139;
    border-radius: 6px;
    padding: 8px;
    color: #d0d4dc;
    font-size: 12px;
    selection-background-color: #2d5a88;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #3a404d;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #505868;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}


/* =========================================================
   BOTTOM BAR
========================================================= */

QWidget#bottomBar {
    background-color: #181b20;
    border-top: 1px solid #2b3038;
}


/* =========================================================
   TOOLTIP
========================================================= */

QToolTip {
    background-color: #232830;
    color: #f0f0f0;
    border: 1px solid #4a5160;
    padding: 6px 8px;
    font-size: 12px;
}
